version 41
__lua__
--variables

function _init()
	--table(aka string?):
	-- in a table : 
	-- lhs = rhs
	-- key = value
	player={
		--sprite number
		sp = 1,
		x = 59,
		y = 59,
		w = 8,
		h = 8,
		flipped = false,
		
		--advanced movement
			--movement speed
		 dx = 0, //change in x
		 dy = 0, //change in y
		 max_dx = 2.3,
		 max_dy = 3,
		 acc = 0.5,//acceleration
		 boost = 4,//jump acceleration
		 --animation
		 anim = 0,//animation timing
		 //states of animation!
		 running = false,
		 jumping = false, 
		 falling = false,
		 sliding = false,
		 landed =	 false
	}
	--physics variable
		 gravity = 0.3
			friction = 0.85
	
	--simple camera
		
		cam_x = 0
		
	--map limits
	
	map_start = 0
	map_end = 8*128
	
-----------testing-------------	
//	x1r=0 y1r=0  x2r=0  y2r=0
	
//	collide_l = "no"
//	collide_r = "no"
//	collide_u = "no"	
//	collide_d = "no"
	----------------------------
end






-->8
--update and draw

function _update()
	player_update()
	player_animate()

	--simple camera
	
	cam_x = player.x-(64+player.w/2)
	if cam_x < map_start then
		cam_x = map_start
	end
	
	if cam_x > map_end-128 then
		cam_x = map_end-128
	end
	camera(cam_x,0)
	
end


function _draw()
	cls()
	map(0,0)
	--since sp is not a variable 
	--it is a key, so we access
	--the key using the table 
	--name as reffrence! 
	--then access it via .
	--kind of like a class!!
	spr(player.sp,player.x,player.y,player.w/8,player.h/8,player.flipped)
